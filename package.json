{
  "name": "vue-3d-loader",
  "private": false,
  "version": "2.3.0",
  "main": "dist/vue-3d-loader.cjs.js",
  "module": "dist/vue-3d-loader.esm.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && vite build -c vite.config.global.ts && npm run build:types",
    "build:types": "node scripts/build-types.js",
    "build:example": "vue-tsc --noEmit && vite build --mode examples",
    "build:docker": "vue-tsc --noEmit && vite build --mode docker",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/three": "^0.185.1",
    "three": "^0.185.1",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/compiler-sfc": "^3.5.17",
    "fast-glob": "^3.3.3",
    "ts-morph": "^25.0.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vue-tsc": "^3.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/king2088/vue-3d-loader.git"
  },
  "bugs": {
    "url": "https://github.com/king2088/vue-3d-loader/issues"
  },
  "homepage": "https://github.com/king2088/vue-3d-loader",
  "keywords": [
    "vue",
    "3d",
    "threeJS",
    "3d viewer",
    "vue 3d"
  ],
  "license": "MIT"
}